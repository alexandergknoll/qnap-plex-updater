#!/bin/sh
#
# qnap-plex-updater - Update Plex Media Server on QNAP NAS
#

set -eu

PROG_NAME="${0##*/}"
VERSION="2.0.0"

msg() { printf '%b\n' "$*"; }

log() {
  printf '%b\n' "$*" >&2
  if [ -n "${LOG_FILE}" ]; then
    printf '%s %b\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
  fi
}

die() {
  _die_rc=1
  case "${1-}" in [0-9]*) _die_rc="$1"; shift ;; esac
  log "$*"
  exit "$_die_rc"
}

version() { msg "$PROG_NAME $VERSION"; }

usage() {
  version
  cat <<EOF
Usage: $PROG_NAME [parameters] <options>

Update Plex Media Server on QNAP NAS.

Parameters:
  -c, --channel CHANNEL   update channel: public (default) or beta
  -d, --directory PATH    download directory
  --log FILE              append output to FILE with timestamps

Options:
  --check                 check for updates without installing
  --force                 reinstall even if already up to date
  -n, --notify            send QTS/QuTS notification on successful install
  -V, --verbose           output debug information
  -v, --version           display version and exit
  -h, --help              display this help message and exit

Report bugs to https://github.com/barnumbirr/qnap-plex-updater/issues
EOF
}

parse_config_file() {
  /sbin/getcfg -f "$1" "$2" "$3"
}

detect_plex() {
  AARCH="$(/bin/uname -m)"
  QPKG_NAME="PlexMediaServer"
  QPKG_CONF="/etc/config/qpkg.conf"
  REGEX_PLEX_VERSION='([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+-\b[0-9a-f]{9}\b)'

  if [ "$CHANNEL" = "public" ]; then
    CHANNEL=0
  elif [ "$CHANNEL" = "beta" ]; then
    CHANNEL=1
  else
    die "'channel' can only be one of 'public' or 'beta', exiting..."
  fi

  PLEX_DIR="$(parse_config_file "$QPKG_CONF" "$QPKG_NAME" Install_path)"
  PLEX_INIT_SCRIPT="$(parse_config_file "$QPKG_CONF" "$QPKG_NAME" Shell)"
  PLEX_TOKEN="$(sed -n 's/.*PlexOnlineToken="\([^"]*\)".*/\1/p' \
                "${PLEX_DIR}/Library/Plex Media Server/Preferences.xml")"

  [ -n "${PLEX_TOKEN}" ] || die "PlexOnlineToken not found in ${PLEX_DIR}/Library/Plex Media Server/Preferences.xml"

  PLEX_API_URL="https://plex.tv/downloads/latest/5?channel=${CHANNEL}&build=linux-${AARCH}&distro=qnap"
}

get_local_version() {
  # Don't exit if LOCAL_PLEX_VERSION is empty, i.e PMS is not installed or simply not running.
  LOCAL_PLEX_VERSION="$(/sbin/curl \
    --silent \
    --max-time 30 \
    http://localhost:32400/identity \
    | /bin/grep -ioE "${REGEX_PLEX_VERSION}")" || true
}

get_remote_version() {
  REMOTE_PLEX_VERSION="$(/sbin/curl \
    --location \
    --head \
    --max-time 30 \
    --header "X-Plex-Token: ${PLEX_TOKEN}" \
    --write-out '%{url_effective}' \
    "${PLEX_API_URL}" \
    2>/dev/null | /usr/bin/tail -n1 | /bin/grep -ioE "${REGEX_PLEX_VERSION}" | /bin/uniq)"

  [ -n "${REMOTE_PLEX_VERSION}" ] || die "failed to determine latest Plex Media Server version"
}

download() {
  if [ -z "${DOWNLOAD_DIR}" ]; then
    DOWNLOAD_DIR="$(parse_config_file /etc/config/def_share.info SHARE_DEF defVolMP)"
  fi

  if [ "$(df -Pm "$DOWNLOAD_DIR" | awk 'NR==2 {print $4}')" -lt 150 ]; then
    die "Not enough free space in $DOWNLOAD_DIR, exiting..."
  fi

  QPKG_FILE="${DOWNLOAD_DIR}/${QPKG_NAME}.qpkg"
  trap 'rm -f "$QPKG_FILE"' EXIT INT TERM

  log "Downloading Plex Media Server ${REMOTE_PLEX_VERSION}-${AARCH}..."

  /sbin/curl \
    --silent \
    --fail \
    --location \
    --max-time 300 \
    --header "X-Plex-Token: ${PLEX_TOKEN}" \
    --output "$QPKG_FILE" \
    "${PLEX_API_URL}" || die "download failed"

  [ -s "$QPKG_FILE" ] || die "download produced an empty file"
}

install() {
  "${PLEX_INIT_SCRIPT}" stop

  log "Installing and restarting Plex Media Server..."
  sh "$QPKG_FILE"

  rm -f "$QPKG_FILE"
  trap - EXIT INT TERM

  log "Plex Media Server ${REMOTE_PLEX_VERSION}-${AARCH} installed successfully!"

  if [ "${NOTIFY}" -eq 1 ]; then
    /sbin/notice_log_tool -a "Plex Media Server ${REMOTE_PLEX_VERSION}-${AARCH} installed." --severity=5
  fi
}

check() {
  detect_plex
  get_local_version
  get_remote_version

  if [ "${LOCAL_PLEX_VERSION:-0.0.0.0-000000000}" = "${REMOTE_PLEX_VERSION}" ]; then
    log "Up to date: Plex Media Server ${REMOTE_PLEX_VERSION}-${AARCH}"
    exit 1
  fi

  log "Update available: ${LOCAL_PLEX_VERSION:-none} -> ${REMOTE_PLEX_VERSION}-${AARCH}"
  exit 0
}

main() {
  detect_plex
  get_local_version
  get_remote_version

  if [ "${FORCE}" -eq 0 ] && [ "${LOCAL_PLEX_VERSION:-0.0.0.0-000000000}" = "${REMOTE_PLEX_VERSION}" ]; then
    log "Latest Plex Media Server version (${REMOTE_PLEX_VERSION}-${AARCH}) already installed, exiting..."
    exit 0
  fi

  download
  install
}

parse_params() {
  CHANNEL='public'
  CHECK=0
  DOWNLOAD_DIR=''
  FORCE=0
  LOG_FILE=''
  NOTIFY=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h | --help)    usage; exit 0 ;;
      -v | --version) version; exit 0 ;;
      -V | --verbose) set -x ;;
      -c | --channel)
        [ "${2-}" ] || die "missing value after $1"
        CHANNEL="$(printf '%s' "$2" | awk '{print tolower($0)}')"
        shift
        ;;
      -d | --directory)
        [ "${2-}" ] || die "missing value after $1"
        DOWNLOAD_DIR="$2"
        shift
        ;;
      --check) CHECK=1 ;;
      --force) FORCE=1 ;;
      --log)
        [ "${2-}" ] || die "missing value after $1"
        LOG_FILE="$2"
        shift
        ;;
      -n | --notify) NOTIFY=1 ;;
      -?*) die "Unknown option: $1\nSee -h/--help for more details" ;;
      *)   break ;;
    esac
    shift
  done

  [ "${CHECK}" -eq 1 ] && [ "${FORCE}" -eq 1 ] && die "--check and --force are mutually exclusive"

  if [ "${CHECK}" -eq 1 ]; then
    check
  else
    main
  fi
}

parse_params "$@"
