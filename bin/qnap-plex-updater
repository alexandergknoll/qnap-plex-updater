#!/usr/bin/env bash

readonly PROJECT=qnap-plex-updater
readonly VERSION=1.1.0

set -euo pipefail

#Security: Curl options for enhanced TLS validation
readonly CURL_SECURE_OPTS=(
    --fail                    # Fail on HTTP errors
    --show-error             # Show errors even in silent mode
    --silent                 # Hide progress
    --proto '=https'         # Only allow HTTPS
    --tlsv1.2                # Minimum TLS 1.2
    --max-redirs 3           # Limit redirect chains
    --connect-timeout 30     # Connection timeout
    --max-time 300           # Maximum time for operation
)

usage() {
    version
    die """
Usage: $PROJECT [parameters] <options>...
$PROJECT is a CLI tool written in BASH aimed at updating Plex Media Server
on QNAP servers.

PARAMETERS:
-c, --channel <channel>    Specifies Plex Media Server update channel (public/beta).
-d, --directory <path>     Specifies download directory.

OPTIONS:
-h, --help       Show this help log.
-n, --notify     Output QTS/QuTS notice board notification on successful install.
-V, --verbose    Output debug information.
-v, --version    Show version information.

Report bugs to https://github.com/barnumbirr/qnap-plex-updater/issues"""
}

version() {
    log "$PROJECT $VERSION"
}

log() {
    echo >&2 -e "${1-}"
}

die() {
  local log=$1
  log "$log"
  exit 1
}

parse_params() {
    CHANNEL='public'
    DOWNLOAD_DIR=''
    NOTIFY=0

    while :; do
        case "${1-}" in
        -h | --help)
            usage
            ;;
        -v | --version)
            version
            exit 1
            ;;
        -V | --verbose)
            set -x
            ;;
        -c | --channel)
            CHANNEL="$(echo "${2-}" | awk '{print tolower($0)}')"
            shift
            ;;
        -d | --directory)
            DOWNLOAD_DIR="${2-}"
            shift
            ;;
        -n | --notify)
            NOTIFY=1
            ;;
        -?*)
            die "Unknown option: $1
See -h/--help for more details"
            ;;
        *)
            break
            ;;
        esac
        shift
    done

    return 0
}

parse_config_file() {
    local file=$1
    local object=$2
    local key=$3
    /sbin/getcfg -f "${file}" "${object}" "${key}"
}

prompt_security_warning() {
    local message=$1

    # Check if running interactively (stdin is a terminal)
    if [[ ! -t 0 ]]; then
        # Non-interactive mode (cron/automated) - abort for security
        die "SECURITY: $message
Running non-interactively (cron/automated). Aborting update for security.
To proceed, run this script manually and confirm the security warning."
    fi

    # Interactive mode - prompt user
    log "WARNING: $message"
    log ""
    read -p "Do you want to proceed anyway? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        die "Update aborted by user for security reasons."
    fi
    log "User confirmed - proceeding with update..."
}

fetch_checksum_from_api() {
    local arch=$1
    local version=$2
    local channel=$3
    local plex_token=$4
    local plex_client_id=$5

    # Add ?channel=plexpass for beta/Plex Pass releases
    local checksum_url="https://plex.tv/api/downloads/5.json"
    if [[ "$channel" == "1" ]]; then
        checksum_url="${checksum_url}?channel=plexpass"
    fi

    # Debug output
    log "DEBUG: Fetching checksum from API..."
    log "  API URL: ${checksum_url}"
    log "  Architecture: linux-${arch}"
    log "  Version: ${version}"
    log "  Channel: ${channel} (0=public, 1=beta)"

    # Fetch JSON with authentication headers (required for beta releases)
    # Using BusyBox-compatible grep and sed (no Perl regex -P flag)
    local json_data=$(/sbin/curl "${CURL_SECURE_OPTS[@]}" \
                      --header "X-Plex-Token: ${plex_token}" \
                      --header "X-Plex-Client-Identifier: ${plex_client_id}" \
                      "${checksum_url}" 2>/dev/null)

    # Build the exact .qpkg filename to search for
    # This uniquely identifies the release: PlexMediaServer-{version}-{arch}.qpkg
    local qpkg_filename="PlexMediaServer-${version}-${arch}.qpkg"

    log "DEBUG: Searching for exact filename: ${qpkg_filename}"

    # Search for the line containing this exact filename and extract its checksum
    # This ensures we get the checksum from the correct QNAP release, not other NAS vendors
    local checksum=$(echo "$json_data" | \
                     /bin/grep "${qpkg_filename}" | \
                     sed -n 's/.*"checksum":"\([a-f0-9]\{40\}\)".*/\1/p' | \
                     head -1)

    if [[ -z "$checksum" ]]; then
        log "DEBUG: No checksum found matching version ${version}"
        # Return error code without calling die/prompt (will be handled in main)
        return 1
    fi

    log "DEBUG: Selected checksum: ${checksum}"
    echo "$checksum"
}

verify_checksum() {
    local file=$1
    local expected_checksum=$2

    if [[ -z "$expected_checksum" ]]; then
        # Checksum not available (user already confirmed in fetch_checksum_from_api)
        log "Skipping checksum verification (user confirmed)."
        return 0
    fi

    log "Verifying package integrity (SHA-1 checksum)..."

    # Calculate SHA-1 checksum of downloaded file
    local actual_checksum=$(sha1sum "$file" | awk '{print $1}')

    if [[ "$actual_checksum" != "$expected_checksum" ]]; then
        die "SECURITY ERROR: Checksum verification FAILED!
Expected: $expected_checksum
Got:      $actual_checksum

The downloaded package may be corrupted or compromised.
This could indicate:
- Network transmission error
- Man-in-the-middle attack
- Compromised download source

ABORTING INSTALLATION FOR SECURITY."
    fi

    log "✓ Checksum verification passed."
}

validate_init_script() {
    local script_path=$1

    # Check if file exists
    if [[ ! -f "$script_path" ]]; then
        die "Init script not found: $script_path"
    fi

    # Check for invalid characters in path (allow dots for .qpkg and .sh)
    if [[ ! "$script_path" =~ ^/[a-zA-Z0-9./_-]+$ ]]; then
        die "Init script path contains invalid characters: $script_path"
    fi

    # Resolve symlinks to prevent symlink attacks (try multiple methods for portability)
    if command -v realpath >/dev/null 2>&1; then
        script_path="$(realpath "$script_path" 2>/dev/null)" || script_path="$script_path"
    elif command -v readlink >/dev/null 2>&1; then
        script_path="$(readlink -f "$script_path" 2>/dev/null)" || script_path="$script_path"
    fi
    # If neither command is available, continue with original path

    # Verify script is owned by root (UID 0)
    local owner_uid=$(stat -c '%u' "$script_path" 2>/dev/null)
    if [[ "$owner_uid" != "0" ]]; then
        die "Init script must be owned by root (current owner UID: $owner_uid): $script_path"
    fi

    # Verify script is not world-writable
    local perms=$(stat -c '%a' "$script_path" 2>/dev/null)
    local world_writable=${perms:2:1}
    if [[ "$world_writable" =~ [2367] ]]; then
        die "Init script is world-writable (insecure permissions $perms): $script_path"
    fi

    echo "$script_path"
}

main() {
    AARCH="$(/bin/uname -m)"
    QPKG_NAME="PlexMediaServer"
    QPKG_CONF="/etc/config/qpkg.conf"
    REGEX_PLEX_VERSION='([0-9]+.[0-9]+.[0-9]+.[0-9]+-\b[0-9a-f]{9}\b)'
    PLEX_DIR="$(parse_config_file "$QPKG_CONF" "$QPKG_NAME" Install_path)"
    PLEX_INIT_SCRIPT="$(parse_config_file "$QPKG_CONF" "$QPKG_NAME" Shell)"

    # Validate init script path before use
    PLEX_INIT_SCRIPT="$(validate_init_script "$PLEX_INIT_SCRIPT")"

    PLEX_TOKEN="$(/bin/grep PlexOnlineToken "${PLEX_DIR}"/Library/Plex\ Media\ Server/Preferences.xml \
                  | sed -e 's/.*PlexOnlineToken=\"//' -e 's/\".*//')"
    PLEX_CLIENT_ID="$(/bin/grep ProcessedMachineIdentifier "${PLEX_DIR}"/Library/Plex\ Media\ Server/Preferences.xml \
                       | sed -e 's/.*ProcessedMachineIdentifier=\"//' -e 's/\".*//')"

    # Fallback to MachineIdentifier if ProcessedMachineIdentifier not found
    if [[ -z "$PLEX_CLIENT_ID" ]]; then
        PLEX_CLIENT_ID="$(/bin/grep MachineIdentifier "${PLEX_DIR}"/Library/Plex\ Media\ Server/Preferences.xml \
                           | sed -e 's/.*MachineIdentifier=\"//' -e 's/\".*//' | head -1)"
    fi
    # Don't exit if LOCAL_PLEX_VERSION is empty, i.e PMS is not installed or simply not running.
    LOCAL_PLEX_VERSION="$(/sbin/curl \
                          --silent \
                          http://localhost:32400/identity \
                          | /bin/grep -ioE "${REGEX_PLEX_VERSION}")" || true

    # Convert channel name to numeric value (needed for download URL and API)
    if [[ "${CHANNEL}" == "public" ]]; then
        CHANNEL=0
    elif [[ "${CHANNEL}" == "beta" ]]; then
        CHANNEL=1
    else
        die "'channel' can only be one of 'public' or 'beta', exiting..."
    fi

    # Use HTTP header for token to prevent exposure in process lists
    REMOTE_PLEX_VERSION="$(/sbin/curl \
                           "${CURL_SECURE_OPTS[@]}" \
                           --location \
                           --head \
                           --write-out '%{url_effective}' \
                           --header "X-Plex-Token: ${PLEX_TOKEN}" \
                           "https://plex.tv/downloads/latest/5?channel=${CHANNEL}&build=linux-${AARCH}&distro=qnap" \
                           2>/dev/null | /usr/bin/tail -n1 | /bin/grep -ioE "${REGEX_PLEX_VERSION}" | /bin/uniq)"

    # If PMS is not installed or simply not running, just fetch and install the latest version available.
    # Do nothing and exit if latest version is already installed.
    if [[ "${LOCAL_PLEX_VERSION:-0.0.0.0-000000000}" == "${REMOTE_PLEX_VERSION}" ]]; then
        die "Latest Plex Media Server version (${REMOTE_PLEX_VERSION}-${AARCH}) already installed, exiting..."
    fi

    if [[ -z "${DOWNLOAD_DIR}" ]]; then
        DOWNLOAD_DIR="$(parse_config_file /etc/config/def_share.info SHARE_DEF defVolMP)"
    elif [[ "$(df -Pm "$DOWNLOAD_DIR" | awk 'NR==2 {print $4}')" -lt 150 ]]; then
        die "Not enough free space in $DOWNLOAD_DIR, exiting..."
    fi

    log "Downloading Plex Media Server ${REMOTE_PLEX_VERSION}-${AARCH}..."

    # Fetch expected checksum from Plex API with authentication for beta/plexpass releases
    if ! EXPECTED_CHECKSUM="$(fetch_checksum_from_api "${AARCH}" "${REMOTE_PLEX_VERSION}" "${CHANNEL}" "${PLEX_TOKEN}" "${PLEX_CLIENT_ID}")"; then
        # Checksum fetch failed - prompt user for security decision
        prompt_security_warning "Could not fetch checksum from Plex API.
The downloaded package cannot be verified for integrity.
This could allow installation of corrupted or malicious packages.

Possible causes:
- Network connectivity issues
- Plex API temporarily unavailable
- Architecture '${AARCH}' not found in API response

Proceeding without verification is a SECURITY RISK."
        EXPECTED_CHECKSUM=""
    fi

    # Download package using secure curl options and HTTP header for token
    if ! /sbin/curl \
        "${CURL_SECURE_OPTS[@]}" \
        --location \
        --header "X-Plex-Token: ${PLEX_TOKEN}" \
        --output "${DOWNLOAD_DIR}"/"${QPKG_NAME}".qpkg \
        "https://plex.tv/downloads/latest/5?channel=${CHANNEL}&build=linux-${AARCH}&distro=qnap"; then
        die "Failed to download Plex Media Server package from plex.tv"
    fi

    # Verify package checksum before installation
    verify_checksum "${DOWNLOAD_DIR}/${QPKG_NAME}.qpkg" "${EXPECTED_CHECKSUM}"

    "${PLEX_INIT_SCRIPT}" stop

    log "Installing and restarting Plex Media Server..."
    : "$(sh "${DOWNLOAD_DIR}"/"${QPKG_NAME}".qpkg > /dev/null 2>&1)" &
    wait $!

    rm "${DOWNLOAD_DIR}"/"${QPKG_NAME}".qpkg
    log "Plex Media Server ${REMOTE_PLEX_VERSION}-${AARCH} installed successfully!"

    if [[ ${NOTIFY} -eq 1 ]]; then
        /sbin/notice_log_tool -a "Plex Media Server ${REMOTE_PLEX_VERSION}-${AARCH} installed." --severity=5
    fi
}

parse_params "$@"
main
